# ============================================================
# GoMoto — Mapa de variáveis de ambiente
# ============================================================
#
# Este arquivo NÃO é lido por nenhum app diretamente.
# É uma referência do que existe e onde cada var deve ser configurada.
#
# ─────────────────────────────────────────────────────────────
# ONDE CONFIGURAR CADA VARIÁVEL:
#
#   apps/web/.env.local          → Next.js (NEXT_PUBLIC_* + secrets)
#   apps/mobile/.env.local       → Expo (EXPO_PUBLIC_* — bundled no app)
#   supabase secrets             → Edge Functions (Deno.env.get)
#   Vercel dashboard (env vars)  → produção
# ─────────────────────────────────────────────────────────────
#
# Para desenvolvimento local:
#   cp apps/web/.env.local.example apps/web/.env.local
#   cp apps/mobile/.env.local.example apps/mobile/.env.local
#   pnpm db:start && pnpm db:status  → mostra as chaves do Docker
#
# ============================================================

# ── WEB (apps/web/.env.local) ──────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321          # local Docker
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...               # de: pnpm db:status
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...                   # de: pnpm db:status
# MERCADOPAGO_CLIENT_ID=                                   # painel MP
# MERCADOPAGO_CLIENT_SECRET=                               # painel MP
# MERCADOPAGO_REDIRECT_URI=http://localhost:3000/api/auth/mercadopago/callback

# ── MOBILE (apps/mobile/.env.local) ────────────────────────
# EXPO_PUBLIC_SUPABASE_URL=http://<IP-LAN>:54321           # IP da máquina na rede local
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...               # de: pnpm db:status
# EXPO_PUBLIC_WEB_URL=https://<slug>.ngrok.io              # túnel para o Next.js local

# ── EDGE FUNCTIONS (supabase secrets set KEY=VALUE) ────────
# SUPABASE_URL=                                            # automático no Supabase
# SUPABASE_SERVICE_ROLE_KEY=                               # automático no Supabase
# MERCADOPAGO_WEBHOOK_SECRET=                              # painel MP → Webhooks

# ── PRODUÇÃO (Vercel dashboard) ─────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# MERCADOPAGO_CLIENT_ID=
# MERCADOPAGO_CLIENT_SECRET=
# MERCADOPAGO_REDIRECT_URI=https://<dominio>/api/auth/mercadopago/callback
