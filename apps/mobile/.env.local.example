# ============================================================
# GoMoto Mobile — Variáveis de ambiente locais
# ============================================================
#
# Para usar:
#   1. cp .env.local.example .env.local
#   2. Cole as chaves do Supabase local (pegue de `pnpm db:status` no root)
#
# Convenção Expo: prefixo EXPO_PUBLIC_ → embutido no bundle e
# acessível via process.env.EXPO_PUBLIC_*
# ============================================================

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# anon key (pegue de `pnpm db:status` — campo "anon key")
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# URL base do web (Next.js) — usado para geração de Pix mobile
# Desenvolvimento: URL do ngrok (ex: https://abcd1234.ngrok.io)
# Produção: https://seu-dominio.vercel.app
EXPO_PUBLIC_WEB_URL=

# ============================================================
# Login de teste (criado pelo seed.sql):
