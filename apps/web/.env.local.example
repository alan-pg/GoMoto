# ============================================================
# GoMoto — Variáveis de ambiente para desenvolvimento LOCAL
# ============================================================
#
# Para usar:
#   1. cp .env.local.example .env.local
#   2. npm run db:start
#   3. npm run db:status  (mostra as chaves abaixo já preenchidas)
#   4. Cole as chaves de `db:status` neste arquivo
#
# Diferente do .env.example (que aponta para produção/cloud),
# este aponta para o stack Supabase rodando em Docker localmente.
# ============================================================

# Supabase local (Docker)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# anon key (pegue de `npm run db:status` — campo "anon key")
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service role key — NUNCA exposta no client (pegue de `npm run db:status`)
SUPABASE_SERVICE_ROLE_KEY=

